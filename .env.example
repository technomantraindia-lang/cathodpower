# EmailJS — sends a welcome/confirmation email to the subscriber with a resource link.
# Create a free account at https://www.emailjs.com/
# Template should email {{user_email}} and include {{resource_link}} in the message body.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: link included in the subscriber email (defaults to /downloads on current site)
VITE_NEWSLETTER_RESOURCE_LINK=https://cathodepower.com/downloads
